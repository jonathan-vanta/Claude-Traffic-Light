{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Traffic Light",
  "version": "0.1.0",
  "identifier": "com.claudetrafficlight.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Claude Traffic Light",
        "width": 154,
        "height": 58,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "visible": true,
        "shadow": false
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ],
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
